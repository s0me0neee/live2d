{
	"name": "web2d",
	"productName": "web2d",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "dist-electron/main.cjs",
	"workspaces": [
		"global_hotkey",
		"overlay_hyprland"
	],
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:perf": "node scripts/dev.mjs --perf",
		"dev:renderer": "vite",
		"build:native": "cd global_hotkey && bun run build && cd ../overlay_hyprland && bun run build",
		"build": "bun run build:native && bun install && tsc && vite build && node scripts/build-electron.mjs",
		"build:renderer": "tsc && vite build",
		"build:electron": "node scripts/build-electron.mjs",
		"start": "electron .",
		"preview": "vite preview",
		"release": "node scripts/release.mjs",
		"test": "bun test"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "^0.10.35",
		"@web2d/global-hotkey": "workspace:*",
		"@web2d/overlay_hyprland": "workspace:*",
		"koffi": "^3.1.0",
		"picocolors": "^1.1.1",
		"pixi-live2d-display-lipsyncpatch": "0.5.0-ls-8",
		"pixi.js": "^7.4.3",
		"smol-toml": "^1.7.0"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.7.2",
		"@types/bun": "^1.3.14",
		"electron": "43.0.0",
		"esbuild": "0.28.1",
		"typescript": "~7.0.2",
		"vite": "^8.1.3"
	},
	"trustedDependencies": ["esbuild", "koffi"]
}
